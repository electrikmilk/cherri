// compile-only: alarms, timers, stopwatch and world clock change state on the device

@alarm = "alarm"

createAlarm("Wake", "07:30")
createAlarm("Gym", "06:00", false, ["monday", "friday"])
createAlarm("Silent", "08:00", true, ["monday"], false)
deleteAlarm(@alarm)
turnOnAlarm(@alarm)
turnOnAlarm(@alarm, false)
turnOffAlarm(@alarm)
toggleAlarm(@alarm)

getAlarms()
openAlarm(@alarm)

startTimer(qty(5, "min"))
pauseTimer()
resumeTimer()
getCurrentTimerDetail("remainingTime")
getCurrentTimerDetail("duration")
toggleSleepAlarm("skip")
toggleSleepAlarm("unskip")
toggleSleepAlarm("toggle")
cancelTimer()

startStopwatch()
lapStopwatch(false)
stopStopwatch(false)
resetStopwatch(false)

@city = "Austin"
@cities = ["Cairo", "Austin"]

addWorldClock("Alexandria")
addWorldClock("Austin", false)
addWorldClock("Kingston (134)")
addWorldClock(@city)
getCityTime("Cairo")
getCityTime(@city)
removeWorldClock(["Cairo"])
removeWorldClock(["Cairo", "Austin"], false)
removeWorldClock(@cities)

openClockTab("timer")

show("✅ All tests passed")
