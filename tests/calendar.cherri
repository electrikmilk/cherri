// compile-only: alarms, timers, stopwatch and world clock change state on the device

@alarm = "alarm"

createAlarm("Wake", "07:30")
createAlarm("Gym", "06:00", false, ["monday", "friday"])
deleteAlarm(@alarm)
turnOnAlarm(@alarm)
turnOnAlarm(@alarm, false)
turnOffAlarm(@alarm)
toggleAlarm(@alarm)

getAlarms()
openAlarm(@alarm)

startTimer(qty(5, "min"))
pauseTimer()
resumeTimer()
getCurrentTimerDetail("remainingTime")
getCurrentTimerDetail("duration")
cancelTimer()

startStopwatch()
lapStopwatch()
stopStopwatch()
resetStopwatch()

@city = "city"

addWorldClockCity(@city)
getTimeForCity(@city)
removeWorldClockCity(@city)

openClockTab("timer")

show("✅ All tests passed")
