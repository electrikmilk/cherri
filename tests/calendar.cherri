// compile-only: alarms, timers, stopwatch, world clock and reminders groups change state on the device

@alarm = "alarm"

createAlarm("Wake", "07:30")
createAlarm("Gym", "06:00", false, ["monday", "friday"])
createAlarm("Silent", "08:00", true, ["monday"], false)
deleteAlarm(@alarm)
turnOnAlarm(@alarm)
turnOnAlarm(@alarm, false)
turnOffAlarm(@alarm)
toggleAlarm(@alarm)

getAlarms()
openAlarm(@alarm)

startTimer(qty(5, "min"))
pauseTimer()
resumeTimer()
getCurrentTimerDetail("remainingTime")
getCurrentTimerDetail("duration")
toggleSleepAlarm("skip")
toggleSleepAlarm("unskip")
toggleSleepAlarm("toggle")
cancelTimer()

startStopwatch()
lapStopwatch(false)
stopStopwatch(false)
resetStopwatch(false)

@city = "Austin, US"
@cities = ["Cairo, Egypt", "Austin, US"]

addWorldClock("Alexandria, Egypt")
addWorldClock("Austin, US", false)
addWorldClock("Kingston, Jamaica")
addWorldClock("San Jose, US")
addWorldClock("San José, Costa Rica")
addWorldClock("St. John's, Canada")
addWorldClock("UTC")
addWorldClock(@city)
getCityTime("Cairo, Egypt")
getCityTime(@city)
removeWorldClock(["Cairo, Egypt"])
removeWorldClock(["Cairo, Egypt", "Austin, US"], false)
removeWorldClock(@cities)

openClockTab("timer")

const group = makeRemindersGroup("Test")
makeRemindersGroup("Test 2", ShortcutInput)
const section = makeRemindersSection("Section")
makeRemindersSection("Section 2", ShortcutInput)
deleteRemindersGroups(group, true)
deleteRemindersSections(section)
deleteRemindersSections(section, true)

show("✅ All tests passed")
