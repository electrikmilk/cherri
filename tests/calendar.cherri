// compile-only: alarms, timers, stopwatch and world clock change state on the device

@alarm = "alarm"

createAlarm("Wake", "07:30")
createAlarm("Gym", "06:00", false, ["monday", "friday"])
createAlarm("Silent", "08:00", true, ["monday"], false)
deleteAlarm(@alarm)
turnOnAlarm(@alarm)
turnOnAlarm(@alarm, false)
turnOffAlarm(@alarm)
toggleAlarm(@alarm)

getAlarms()
openAlarm(@alarm)

startTimer(qty(5, "min"))
pauseTimer()
resumeTimer()
getCurrentTimerDetail("remainingTime")
getCurrentTimerDetail("duration")
cancelTimer()

startStopwatch()
lapStopwatch(false)
stopStopwatch(false)
resetStopwatch(false)

@city = "city"

addWorldClock(@city)
addWorldClock(@city, false)
getTimeForCity(@city)
removeWorldClock(@city)
removeWorldClock(@city, false)

openClockTab("timer")

show("✅ All tests passed")
