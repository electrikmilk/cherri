// compile-only: flashlight state and app windows are device dependent

flashlightOn()
flashlightOn(0.8)
flashlightOff()
toggleFlashlight()
toggleFlashlight(0.3)

@app = "notes"
openApp("notes")
openApp(@app)
hideApp("notes")
hideApp(@app)
quitApp("notes")
quitApp(@app)
killApp("notes")
killApp(@app)
splitApps("notes", "maps")
splitApps(@app, "maps")
splitApps("notes", "maps", "thirdByTwo")

hideAllApps()
hideAllApps("notes")
hideAllApps("notes", "maps")
quitAllApps()
quitAllApps("notes")
quitAllApps("notes", "maps")
killAllApps()
killAllApps("notes")
killAllApps("notes", "maps")

getOrientation()
showControlCenter()

show("✅ All tests passed")
