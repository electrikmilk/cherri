// compile-only: these Messages actions act on real conversations, so there is nothing to assert on.
#define version 27

const convo = text("conversation")

// Each Tapback is stored as a numeric code, and the message is written under two keys.
sendTapback("Question", convo)
sendTapback("Emphasize", convo)
sendTapback("Laugh At", convo)
sendTapback("Dislike", convo)
sendTapback("Like", convo)
sendTapback("Love", convo)
sendTapback(Ask, convo)

// Untouched options are not written, so a bare action has no state or toggle keys.
markConversationAsRead(convo)
markConversationAsRead(convo, true)
markConversationAsRead(convo, true, false)

openMessagesInbox("Messages")
openMessagesInbox("Unknown Senders")
openMessagesInbox("Spam")
openMessagesInbox("Recently Deleted")
openMessagesInbox("Unread")
openMessagesInbox("Drafts")
openMessagesInbox("Send Later")

show("✅ All tests passed")
