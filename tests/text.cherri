const upper = uppercase("hello")
if upper != "HELLO" {
    mustOutput("❌ FAIL: uppercase — got {upper}, expected 'HELLO'", "❌ FAIL: uppercase — got {upper}, expected 'HELLO'")
}

// action call as an action argument
const upperNested = uppercase(text("hello"))
if upperNested != "HELLO" {
    mustOutput("❌ FAIL: action call as argument — got {upperNested}, expected 'HELLO'", "❌ FAIL: action call as argument — got {upperNested}, expected 'HELLO'")
}

const lower = lowercase("HELLO")
if lower != "hello" {
    mustOutput("❌ FAIL: lowercase — got {lower}, expected 'hello'", "❌ FAIL: lowercase — got {lower}, expected 'hello'")
}

const titled = titleCase("hello world")
if titled != "Hello World" {
    mustOutput("❌ FAIL: titleCase — got {titled}, expected 'Hello World'", "❌ FAIL: titleCase — got {titled}, expected 'Hello World'")
}

const capped = capitalize("hello world")
if capped != "Hello world" {
    mustOutput("❌ FAIL: capitalize — got {capped}, expected 'Hello world'", "❌ FAIL: capitalize — got {capped}, expected 'Hello world'")
}

// replaceText(match, replacement, input)
const replaced = replaceText("l", "r", "hello")
if replaced != "herro" {
    mustOutput("❌ FAIL: replaceText — got {replaced}, expected 'herro'", "❌ FAIL: replaceText — got {replaced}, expected 'herro'")
}

// case-insensitive
const replacedCI = replaceText("L", "r", "heLLo", false)
if replacedCI != "herro" {
    mustOutput("❌ FAIL: replaceText case-insensitive — got {replacedCI}, expected 'herro'", "❌ FAIL: replaceText case-insensitive — got {replacedCI}, expected 'herro'")
}

// regex
const replacedRE = replaceText("[aeiou]", "*", "hello", true, true)
if replacedRE != "h*ll*" {
    mustOutput("❌ FAIL: replaceText regex — got {replacedRE}, expected 'h*ll*'", "❌ FAIL: replaceText regex — got {replacedRE}, expected 'h*ll*'")
}

// splitText then joinText round-trip
@parts = splitText("a,b,c", ",")
const joined = joinText(@parts, "-")
if joined != "a-b-c" {
    mustOutput("❌ FAIL: splitText/joinText — got {joined}, expected 'a-b-c'", "❌ FAIL: splitText/joinText — got {joined}, expected 'a-b-c'")
}

// capitalizeAll (each word capitalized)
const allCapitalized = capitalizeAll("hello world")
if allCapitalized != "Hello World" {
    mustOutput("❌ FAIL: capitalizeAll — got {allCapitalized}, expected 'Hello World'", "❌ FAIL: capitalizeAll — got {allCapitalized}, expected 'Hello World'")
}

// containsText with and without case sensitivity
containsText("hello world", "hello")
containsText("hello world", "hello", false)

// the separator and glue default to a new line
@lines = splitText("a\nb")
const rejoined = joinText(@lines)

// an empty separator splits into every character
@characters = splitText("abc", "")

// separators with a quote, a backslash or a new line are written escaped
@quoteParts = splitText("a\"b", "\"")
const backslashJoined = joinText(@quoteParts, "\\")
if backslashJoined != "a\\b" {
    alert("❌ FAIL: joinText with a backslash - got {backslashJoined}")
}
const lineJoined = joinText(@quoteParts, "-\n-")
if lineJoined != "a-\n-b" {
    alert("❌ FAIL: joinText with a new line - got {lineJoined}")
}

// a custom separator named like a separator is the text it holds
const spacesJoined = joinText(@quoteParts, "Spaces")
if spacesJoined != "aSpacesb" {
    alert("❌ FAIL: joinText with the text Spaces - got {spacesJoined}")
}

// text that starts and ends with a quote, written escaped and as a raw string
@quoted = "\"quoted\""
if @quoted != '"quoted"' {
    alert("❌ FAIL: text that starts and ends with a quote - got {@quoted}")
}

// a backslash is written escaped in text and as is in a raw string
@backslash = "back\\slash"
if @backslash != 'back\slash' {
    alert("❌ FAIL: text with a backslash - got {@backslash}")
}

// a backslash before an inline reference does not escape it
@beforeReference = "\\{@quoted}"
if @beforeReference != '\"quoted"' {
    alert("❌ FAIL: backslash before an inline reference - got {@beforeReference}")
}

// braces are only literal in a raw string, as double quoted text reads them as inline references
@braces = 'brace { and } here'
@bracesAndMore = "{@braces}!"
if @bracesAndMore != 'brace { and } here!' {
    alert("❌ FAIL: text with literal braces - got {@bracesAndMore}")
}

// a backslash before a brace makes it literal in double quoted text, and a reference can sit between them
@escapedBraces = "\{not a reference\}"
if @escapedBraces != '{not a reference}' {
    alert("❌ FAIL: text with escaped braces - got {@escapedBraces}")
}
@escapedAroundReference = "\{{@braces}\}"
if @escapedAroundReference != '{brace { and } here}' {
    alert("❌ FAIL: escaped braces around an inline reference - got {@escapedAroundReference}")
}

show("✅ All tests passed")
