@items = list("alpha", "beta", "gamma", "delta")

// getFirstItem
const first = getFirstItem(@items)
if first.text != "alpha" {
    mustOutput("❌ FAIL: getFirstItem — got {first}, expected 'alpha'", "❌ FAIL: getFirstItem — got {first}, expected 'alpha'")
}

// getLastItem
const last = getLastItem(@items)
if last.text != "delta" {
    mustOutput("❌ FAIL: getLastItem — got {last}, expected 'delta'", "❌ FAIL: getLastItem — got {last}, expected 'delta'")
}

// getListItem: Shortcuts indexes from 1
const second = getListItem(@items, 2)
if second.text != "beta" {
    mustOutput("❌ FAIL: getListItem — got {second}, expected 'beta'", "❌ FAIL: getListItem — got {second}, expected 'beta'")
}

// getListItems: items 2–3 → has value (output is a list, not directly comparable)
const slice = getListItems(@items, 2, 3)
if !slice {
    mustOutput("❌ FAIL: getListItems — returned no value", "❌ FAIL: getListItems — returned no value")
}

// getRandomItem: non-deterministic, only assert has value
const random = getRandomItem(@items)
if !random {
    mustOutput("❌ FAIL: getRandomItem — returned no value", "❌ FAIL: getRandomItem — returned no value")
}

// += append: verify the appended item becomes the last
@mutable = ["x", "y"]
@mutable += "z"
const appended = getLastItem(@mutable)
if appended.text != "z" {
    mustOutput("❌ FAIL: += append — got {appended}, expected 'z'", "❌ FAIL: += append — got {appended}, expected 'z'")
}

// += append multiple times, verify order is preserved
@mutable += "w"
const afterSecond = getLastItem(@mutable)
if afterSecond.text != "w" {
    mustOutput("❌ FAIL: += second append — got {afterSecond}, expected 'w'", "❌ FAIL: += second append — got {afterSecond}, expected 'w'")
}
const stillZ = getListItem(@mutable, 3)
if stillZ.text != "z" {
    mustOutput("❌ FAIL: prior item after append — got {stillZ}, expected 'z'", "❌ FAIL: prior item after append — got {stillZ}, expected 'z'")
}

// a reference as the last item must not be read as an action call by the lookahead
const lastItemReference = text("ref")
@referenceItems = ["a", lastItemReference]
const referenceItem = getLastItem(@referenceItems)
if referenceItem.text != "ref" {
    mustOutput("❌ FAIL: reference as last array item — got {referenceItem}, expected 'ref'", "❌ FAIL: reference as last array item — got {referenceItem}, expected 'ref'")
}

// bare variables in arrays, and in a dictionary inside an array
@bareItem = "item"
const bareItemConst = text("const item")
@bareItems = [@bareItem, bareItemConst]
const bareFirst = getFirstItem(@bareItems)
if bareFirst.text != "item" {
    mustOutput("❌ FAIL: bare variable in array - got {bareFirst}, expected 'item'", "❌ FAIL: bare variable in array - got {bareFirst}, expected 'item'")
}
@bareDictionaries = [{"value": @bareItem}]
const bareDictionaryRaw = getFirstItem(@bareDictionaries)
const bareDictionaryItem = getDictionary(bareDictionaryRaw)
const bareDictionaryValue = getValue(bareDictionaryItem, "value")
if bareDictionaryValue.text != "item" {
    mustOutput("❌ FAIL: bare variable in dictionary in array - got {bareDictionaryValue}, expected 'item'", "❌ FAIL: bare variable in dictionary in array - got {bareDictionaryValue}, expected 'item'")
}

// an action call as an array item references the action output
@actionItems = ["a", text("b")]
const actionItem = getLastItem(@actionItems)
if actionItem.text != "b" {
    mustOutput("❌ FAIL: action call in array — got {actionItem}, expected 'b'", "❌ FAIL: action call in array — got {actionItem}, expected 'b'")
}

show("✅ All tests passed")
