// compile-only: iOS/iPadOS-only third-party actions (Menu Box, dev.alexhay.MenuBox) that read
// and write the author's real Menu Box library. Import Menu Sets, Create Menu Set and Add To Menu
// Set change that library when they run, so anything that writes sits behind a switch that is never
// turned on and only needs to compile.
//
// Exercises the set-level Menu Box actions (actions_menubox.go). The set and tag IDs below are from
// the author's device and only need to compile, not resolve.

#define name MENU BOX SETS TEST
#define color purple

// Export Menu Set — read-only, so it is safe to run.
const exportedSet = exportMenuSet("Output Options", "45ED4600-26EF-4B42-B1EC-F55B5055A3A6")

// Load Menu Set with an alternate set — read-only as well.
const loadedWithAlternate = loadMenuSet("Output Options", "45ED4600-26EF-4B42-B1EC-F55B5055A3A6", true, "toggle", "AAFE6B19-CEBD-4DC2-A580-879298CBA9B1")

// Load Menu Set with every Sort By option, each with an alternate set as in the device export. Passing
// nil skips an optional argument, which must leave its key out.
const sortTitle = loadMenuSet("Output Options", "45ED4600-26EF-4B42-B1EC-F55B5055A3A6", true, "toggle", "AAFE6B19-CEBD-4DC2-A580-879298CBA9B1", "title")
const sortSubtitle = loadMenuSet("Output Options", "45ED4600-26EF-4B42-B1EC-F55B5055A3A6", true, "toggle", "AAFE6B19-CEBD-4DC2-A580-879298CBA9B1", "subtitle")
const sortField1 = loadMenuSet("Output Options", "45ED4600-26EF-4B42-B1EC-F55B5055A3A6", true, "toggle", "AAFE6B19-CEBD-4DC2-A580-879298CBA9B1", "field1")
const sortField2 = loadMenuSet("Output Options", "45ED4600-26EF-4B42-B1EC-F55B5055A3A6", true, "toggle", "AAFE6B19-CEBD-4DC2-A580-879298CBA9B1", "field2")
const sortField3 = loadMenuSet("Output Options", "45ED4600-26EF-4B42-B1EC-F55B5055A3A6", true, "toggle", "AAFE6B19-CEBD-4DC2-A580-879298CBA9B1", "field3")
const sortField4 = loadMenuSet("Output Options", "45ED4600-26EF-4B42-B1EC-F55B5055A3A6", true, "toggle", "AAFE6B19-CEBD-4DC2-A580-879298CBA9B1", "field4")
const sortCreated = loadMenuSet("Output Options", "45ED4600-26EF-4B42-B1EC-F55B5055A3A6", true, "toggle", "AAFE6B19-CEBD-4DC2-A580-879298CBA9B1", "dateCreated")
const sortModified = loadMenuSet("Output Options", "45ED4600-26EF-4B42-B1EC-F55B5055A3A6", true, "toggle", "AAFE6B19-CEBD-4DC2-A580-879298CBA9B1", "dateModified")
const sortOnly = loadMenuSet("Output Options", "45ED4600-26EF-4B42-B1EC-F55B5055A3A6", nil, nil, nil, "title")

// Order — descending is written, ascending is the default and leaves the key out.
const sortDescending = loadMenuSet("Output Options", "45ED4600-26EF-4B42-B1EC-F55B5055A3A6", true, "toggle", "AAFE6B19-CEBD-4DC2-A580-879298CBA9B1", "dateModified", "descending")
const sortAscending = loadMenuSet("Output Options", "45ED4600-26EF-4B42-B1EC-F55B5055A3A6", nil, nil, nil, "title", "ascending")

// Find Menu Sets — read-only. The date comes from a Date action, wired in as a variable the way the
// editor stores it.
const createdAfter = currentDate()
const foundByName = findMenuSets("Things", "beginsWith")
const foundAll = findMenuSets("ThingsGPT", nil, "alpha", createdAfter, false, "dateCreated", "latestFirst", 7)
const foundAny = findMenuSets("ThingsGPT", "contains", "alpha", createdAfter, true, "dateModified", "oldestFirst", nil, foundAll)
const foundRandom = findMenuSets(nil, nil, nil, nil, nil, "Random")
const foundEverything = findMenuSets()

// Anything below that writes to the library stays off.
@writeSwitch = 0
if @writeSwitch == 1 {
    // Import Menu Sets — the Export output goes in as a bare variable, with Overwrite Existing on.
    importMenuSets(exportedSet, true)

    // And with the toggle never touched, which must leave the key out.
    importMenuSets(exportedSet)

    // Create Menu Set (Add To Menu Set, Set Type new) — with overwrite and a tag, then bare.
    createMenuSet(exportedSet, "create menu item test name", true, "example", "140C7ABF-A581-46B3-B026-B1A581542D19")
    createMenuSet(loadedWithAlternate, "created from a loaded set")

    // Add To Menu Set (Set Type existing) — found by name alone.
    addToMenuSet(loadedWithAlternate, "ThingsGPT — Image Source")
}

show("✅ All tests passed")
