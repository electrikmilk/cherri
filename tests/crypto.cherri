@input = "hello"

// SHA256 is deterministic for a known input
const sha256 = hash(@input, "SHA256")
if sha256 != "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824" {
    mustOutput("❌ FAIL: hash SHA256 — got {sha256}", "❌ FAIL: hash SHA256 — got {sha256}")
}

// SHA1 of "hello"
const sha1 = hash(@input, "SHA1")
if sha1 != "aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d" {
    mustOutput("❌ FAIL: hash SHA1 — got {sha1}", "❌ FAIL: hash SHA1 — got {sha1}")
}

// base64 encode
const encoded = base64Encode(@input)
if encoded != "aGVsbG8=" {
    mustOutput("❌ FAIL: base64Encode — got {encoded}, expected 'aGVsbG8='", "❌ FAIL: base64Encode — got {encoded}, expected 'aGVsbG8='")
}

// "None" never wraps; the input is long enough that both wrapping modes would insert breaks
@longInput = "The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog again."
const unwrapped = base64Encode(@longInput, "None")
if unwrapped != "VGhlIHF1aWNrIGJyb3duIGZveCBqdW1wcyBvdmVyIHRoZSBsYXp5IGRvZy4gVGhlIHF1aWNrIGJyb3duIGZveCBqdW1wcyBvdmVyIHRoZSBsYXp5IGRvZyBhZ2Fpbi4=" {
    mustOutput("❌ FAIL: base64Encode None — got {unwrapped}", "❌ FAIL: base64Encode None — got {unwrapped}")
}

// The default mode is "Every 76 Characters", so it must differ from the unwrapped output
const wrappedDefault = base64Encode(@longInput)
if wrappedDefault == unwrapped {
    mustOutput("❌ FAIL: base64Encode default mode did not wrap long input", "❌ FAIL: base64Encode default mode did not wrap long input")
}

// 64 breaks at a different width than the 76 default, so the output must differ
const wrapped64 = base64Encode(@longInput, "Every 64 Characters")
if wrapped64 == wrappedDefault {
    mustOutput("❌ FAIL: base64Encode 64 characters matches the 76 character default", "❌ FAIL: base64Encode 64 characters matches the 76 character default")
}

// base64 decode round-trip
@b64 = "aGVsbG8="
const decoded = base64Decode(@b64)
const decodedStr = "{decoded}"
if decodedStr != "hello" {
    mustOutput("❌ FAIL: base64Decode — got {decoded}, expected 'hello'", "❌ FAIL: base64Decode — got {decoded}, expected 'hello'")
}

// SHA512 and MD5: compile-only coverage (MD5 is hash default)
const sha512 = hash(@input, "SHA512")
const md5 = hash(@input)

show("✅ All tests passed")
