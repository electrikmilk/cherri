// == numbers: variable on left, literal on right
@five = 5
@r = "wrong"
if @five == 5 { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: == (numbers)", "❌ FAIL: == (numbers)") }

// != strings
@strA = "a"
@strB = "b"
@r = "wrong"
if @strA != @strB { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: !=", "❌ FAIL: !=") }

// >
@r = "wrong"
if @five > 3 { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: >", "❌ FAIL: >") }

// <
@three = 3
@r = "wrong"
if @three < 5 { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: <", "❌ FAIL: <") }

// >=
@r = "wrong"
if @five >= 5 { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: >=", "❌ FAIL: >=") }

// <=
@r = "wrong"
if @three <= 3 { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: <=", "❌ FAIL: <=") }

// contains
@text = "hello world"
@r = "wrong"
if @text contains "world" { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: contains", "❌ FAIL: contains") }

// !contains
@r = "wrong"
if @text !contains "xyz" { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: !contains", "❌ FAIL: !contains") }

// beginsWith
@r = "wrong"
if @text beginsWith "hello" { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: beginsWith", "❌ FAIL: beginsWith") }

// endsWith
@r = "wrong"
if @text endsWith "world" { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: endsWith", "❌ FAIL: endsWith") }

// between (<>)
@n = 5
@r = "wrong"
if @n <> 1 10 { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: between", "❌ FAIL: between") }

// else branch executes when condition is false
@one = 1
@r = "wrong"
if @one > 10 {} else { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: else", "❌ FAIL: else") }

// if nested in else, the Shortcuts equivalent of else if
@r = "wrong"
if @one > 10 {
    @r = "wrong"
} else {
    if @one == 1 {
        @r = "right"
    }
}
if @r != "right" { mustOutput("❌ FAIL: if nested in else", "❌ FAIL: if nested in else") }

// && (all conditions)
@r = "wrong"
@x = 5
if @x > 3 && @x < 10 { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: &&", "❌ FAIL: &&") }

// || (any condition)
@r = "wrong"
if @x > 100 || @x == 5 { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: ||", "❌ FAIL: ||") }

// bool == true/false
@flag = true
@r = "wrong"
if @flag == true { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: bool == true", "❌ FAIL: bool == true") }

@r = "wrong"
if @flag == false {} else { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: bool == false (else)", "❌ FAIL: bool == false (else)") }

// has value / is empty
@r = "wrong"
@val = "something"
if @val { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: has value", "❌ FAIL: has value") }

@r = "wrong"
@empty = nil
if !@empty { @r = "right" }
if @r != "right" { mustOutput("❌ FAIL: is empty", "❌ FAIL: is empty") }

// else if chains
@chain = 0
repeat step for 4 {
    @chain += 1
    @r = "wrong"
    if @chain == 1 {
        @r = "one"
    } else if @chain == 2 {
        @r = "two"
    } else if @chain == 3 {
        @r = "three"
    } else {
        @r = "other"
    }
    @expected = "other"
    if @chain == 1 { @expected = "one" }
    if @chain == 2 { @expected = "two" }
    if @chain == 3 { @expected = "three" }
    if @r != @expected {
        mustOutput("❌ FAIL: else if chain at {@chain} - got {@r}, expected {@expected}", "❌ FAIL: else if chain at {@chain} - got {@r}, expected {@expected}")
    }
}

// else on the line after the closing brace
@n = 2
@r = "wrong"
if @n == 1 {
    @r = "one"
}
else if @n == 2 {
    @r = "two"
}
else {
    @r = "other"
}
if @r != "two" { mustOutput("❌ FAIL: else if on its own line", "❌ FAIL: else if on its own line") }

// an if nested in an else if block
@n = 2
@m = 5
@r = "wrong"
if @n == 1 {
    @r = "one"
} else if @n == 2 {
    if @m == 5 {
        @r = "nested"
    } else {
        @r = "nested else"
    }
} else {
    @r = "other"
}
if @r != "nested" { mustOutput("❌ FAIL: if nested in else if", "❌ FAIL: if nested in else if") }

// else if with &&
@n = 2
@r = "wrong"
if @n == 1 {
    @r = "one"
} else if @n > 1 && @n < 3 {
    @r = "between"
} else {
    @r = "other"
}
if @r != "between" { mustOutput("❌ FAIL: else if with &&", "❌ FAIL: else if with &&") }

@n = 5
@r = "wrong"
if @n == 1 {
    @r = "one"
} else if @n > 1 && @n < 3 {
    @r = "between"
} else {
    @r = "other"
}
if @r != "other" { mustOutput("❌ FAIL: else if with && falls through", "❌ FAIL: else if with && falls through") }

show("✅ All tests passed")
