@dict = {"name": "Alice", "score": 99, "active": true}

// getValue
const name = getValue(@dict, "name")
if name.text != "Alice" {
    mustOutput("❌ FAIL: getValue — got {name}, expected 'Alice'", "❌ FAIL: getValue — got {name}, expected 'Alice'")
}

// bracket syntax shorthand
@nameAlt = @dict['name']
@nameAltStr = "{@nameAlt}"
if @nameAltStr != "Alice" {
    mustOutput("❌ FAIL: dict['key'] — got {@nameAltStr}, expected 'Alice'", "❌ FAIL: dict['key'] — got {@nameAltStr}, expected 'Alice'")
}

// setValue round-trip
const updated = setValue(@dict, "name", "Bob")
const newName = "{updated['name']}"
if newName != "Bob" {
    mustOutput("❌ FAIL: setValue — got {newName}, expected 'Bob'", "❌ FAIL: setValue — got {newName}, expected 'Bob'")
}

// getDictionary from raw JSON string
@json = '{"key": "hello", "num": 7}'
const parsed = getDictionary(@json)
const parsedVal = "{parsed['key']}"
if parsedVal != "hello" {
    mustOutput("❌ FAIL: getDictionary/getValue — got {parsedVal}, expected 'hello'", "❌ FAIL: getDictionary/getValue — got {parsedVal}, expected 'hello'")
}

// bracket key as an action argument: the key's value type is unknown at compile time,
// so it must not be type-checked as the dictionary it was read from
const keyArgument = text(parsed['key'])
if keyArgument.text != "hello" {
    mustOutput("❌ FAIL: dict['key'] as action argument — got {keyArgument}, expected 'hello'", "❌ FAIL: dict['key'] as action argument — got {keyArgument}, expected 'hello'")
}

// nested dictionary: child dict and mixed array as values
@nested = {
    "meta": {
        "author": "Cherri",
        "version": 1
    },
    "tags": ["compiler", "dsl", "shortcuts"],
    "config": {
        "debug": false,
        "maxDepth": 3
    }
}

// getDictionary() converts a child value to a typed :dictionary before further getValue calls
const metaRaw = getValue(@nested, "meta")
const meta = getDictionary(metaRaw)
@author = "{meta['author']}"
if @author != "Cherri" {
    mustOutput("❌ FAIL: nested dict child getValue — got {@author}, expected 'Cherri'", "❌ FAIL: nested dict child getValue — got {@author}, expected 'Cherri'")
}

const configRaw = getValue(@nested, "config")
const config = getDictionary(configRaw)
const maxDepth = "{config['maxDepth']}"
if maxDepth != "3" {
    mustOutput("❌ FAIL: nested dict second child — got {maxDepth}, expected '3'", "❌ FAIL: nested dict second child — got {maxDepth}, expected '3'")
}

const tags = getValue(@nested, "tags")
if !tags {
    mustOutput("❌ FAIL: nested dict array value — tags missing", "❌ FAIL: nested dict array value — tags missing")
}

// an action call as a dictionary value references the action output
@actionDict = {"label": text("hello")}
const actionDictValue = getValue(@actionDict, "label")
if actionDictValue.text != "hello" {
    mustOutput("❌ FAIL: action call in dictionary — got {actionDictValue}, expected 'hello'", "❌ FAIL: action call in dictionary — got {actionDictValue}, expected 'hello'")
}

// getKeys returns :array (has value check works for any type)
const keys = getKeys(@dict)
if !keys {
    mustOutput("❌ FAIL: getKeys — returned no value", "❌ FAIL: getKeys — returned no value")
}

// getValues returns :array
const vals = getValues(@dict)
if !vals {
    mustOutput("❌ FAIL: getValues — returned no value", "❌ FAIL: getValues — returned no value")
}

// a reference as the last item must not be read as an action call by the lookahead
const lastItemReference = text("ref")
@referenceDictionary = {"first": 1, "last": lastItemReference}
const referenceValue = getValue(@referenceDictionary, "last")
if !referenceValue {
    mustOutput("❌ FAIL: reference as last dictionary item — returned no value", "❌ FAIL: reference as last dictionary item — returned no value")
}

// bare variables in an assigned dictionary are inline text references
@bareText = "bare"
@bareCount = 3
const bareConst = text("constant")
@bareDictionary = {"inline": "{@bareText}", "text": @bareText, "count": @bareCount, "nested": {"inner": bareConst}, "list": [@bareText], "input": ShortcutInput, "last": bareConst}
const bareTextValue = getValue(@bareDictionary, "text")
if bareTextValue.text != "bare" {
    mustOutput("❌ FAIL: bare variable in dictionary - got {bareTextValue}, expected 'bare'", "❌ FAIL: bare variable in dictionary - got {bareTextValue}, expected 'bare'")
}
const bareCountValue = getValue(@bareDictionary, "count")
if bareCountValue.text != "3" {
    mustOutput("❌ FAIL: bare number in dictionary - got {bareCountValue}, expected '3'", "❌ FAIL: bare number in dictionary - got {bareCountValue}, expected '3'")
}
const bareNestedRaw = getValue(@bareDictionary, "nested")
const bareNested = getDictionary(bareNestedRaw)
const bareInner = getValue(bareNested, "inner")
if bareInner.text != "constant" {
    mustOutput("❌ FAIL: bare constant in nested dictionary - got {bareInner}, expected 'constant'", "❌ FAIL: bare constant in nested dictionary - got {bareInner}, expected 'constant'")
}
const bareLast = getValue(@bareDictionary, "last")
if bareLast.text != "constant" {
    mustOutput("❌ FAIL: bare constant as last dictionary item - got {bareLast}, expected 'constant'", "❌ FAIL: bare constant as last dictionary item - got {bareLast}, expected 'constant'")
}

// a fraction and a negative number stay numbers, and text keeps <, > and &
@typed = {"price": 3.5, "delta": -5, "markup": "<b>Tom & Jerry</b>"}
const price = "{@typed['price']}"
if price != "3.5" {
    mustOutput("❌ FAIL: dict fraction - got {price}, expected '3.5'", "❌ FAIL: dict fraction - got {price}, expected '3.5'")
}
const delta = "{@typed['delta']}"
if delta != "-5" {
    mustOutput("❌ FAIL: dict negative number - got {delta}, expected '-5'", "❌ FAIL: dict negative number - got {delta}, expected '-5'")
}
const markup = "{@typed['markup']}"
if markup != "<b>Tom & Jerry</b>" {
    mustOutput("❌ FAIL: dict text with <, > and & - got {markup}, expected '<b>Tom & Jerry</b>'", "❌ FAIL: dict text with <, > and & - got {markup}, expected '<b>Tom & Jerry</b>'")
}

show("✅ All tests passed")
