// compile-only: files on the device are labeled and read

@files = "files"

labelFile(@files, "red")
labelFile(@files, "blue")

filterFiles(@files)
filterFiles(@files, 5)
filterFiles(@files, 5, "File Size")
filterFiles(@files, 5, "File Size", "Biggest First")

getFileFromFolder("~/Documents", "report.pdf")
getFileFromFolder("Shortcuts/Documents", "notes.txt", false)
getFileFromFolder("~/Documents/Projects/Cherri", "main.go")

// an action that starts with app is not an app declaration
@contents = "contents"
appendToFile("notes.txt", @contents)

// Notes
@noteToOpen = "note"
appendNote("Groceries", "Milk")
openNote(@noteToOpen)

show("✅ All tests passed")
