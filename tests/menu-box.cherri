// compile-only: interactive UI and iOS/iPadOS-only third-party actions (Menu Box,
// dev.alexhay.MenuBox) — nothing here is deterministic enough to assert at runtime.
//
// Exercises the first-class Menu Box action definitions (actions_menubox.go) rather than
// the rawAction() escape hatch. One section per action so each can be debugged in isolation.

#define name MENU BOX TEST
#define color purple

// Quick Menu — marked-up text in, menu items out. Covers SF Symbols with default, emoji and hex
// colours, a mask, a scale, transparent backgrounds, and emoji icons.
const quickMenuItems = quickMenu("Title: Example 1\nSub: SFSymbol with default colours\nIcon: waveform.circle.fill\n\nTitle: Example 2\nSub: SFSymbol with weight, scale & emoji colours\nIcon: globe.thin,🟢,⚪️\nScale: Small\n\nTitle: Example 3\nSub: SFSymbol with hex colours and mask\nIcon: gamecontroller.fill, #f12711, #FDC830\nMask: circle\n\nTitle: Example 4\nSub: SFSymbol with transparent background and emoji icon colour\nIcon: touchid,none,teal\nScale: large\n\nTitle: Example 5\nSub: Emoji icon with transparent background\nIcon: 🥰,none\n\nTitle: Example 6\nSub: Emoji icon with scale and no mask\nIcon: 🐭,🟠\nScale: Small\nMask: none")
const quickMenuChoice = chooseFromList(quickMenuItems, "Which one?")

// Quick Menu with the menu text held in a Text action and passed in as a variable — the shape
// Shortcuts produces when the text is built up elsewhere and wired into the action.
const menuText = text("Title: Dictate\nSub: Speak your tasks\nIcon: mic.fill\n\nTitle: Type\nSub: Manually enter your tasks\nIcon: keyboard")
const quickMenuFromVariable = quickMenu(menuText)
const variableChoice = chooseFromList(quickMenuFromVariable)

// Menu Item properties — a chosen item exposes its title, ID and data fields. Confirmed on device
// that a plain property reference works without any extra user info on the aggrandizement.
const dataMenuItems = quickMenu("Title: With data\nSub: Has a field\nField1: Example text")
const dataMenuChoice = chooseFromList(dataMenuItems)
const dataMenuDetails = text("{dataMenuChoice['title']}\n{dataMenuChoice['id']}\n{dataMenuChoice['field1']}")
alert(dataMenuDetails)

// Load Menu Set — the set is an entity resolved by its set ID, which belongs to one Menu Box
// library. The IDs below are from the author's device and only need to compile, not resolve.
const toggleMenu = loadMenuSet("toggle", "AAFE6B19-CEBD-4DC2-A580-879298CBA9B1")
const toggleChoice = chooseFromList(toggleMenu)

const inputSourceMenu = loadMenuSet("ThingsGPT — Input Source", "E092F845-188B-4F16-98FE-D78AE33788C3", false)
const inputSourceChoice = chooseFromList(inputSourceMenu)

// Create Menu Item From Symbol — every parameter we have a verified key for, then the minimum
// (title and symbol only), then one with the subtitle skipped to set only the weight.
const symbolItem = createMenuItemFromSymbol("create A Menu From Sf Symbol Title Example", "microphone", "create a menu from SF symbols subtitle example", "regular", "large", true)
const symbolChoice = chooseFromList(symbolItem)

const minimalSymbolItem = createMenuItemFromSymbol("Minimal", "star")
const minimalSymbolChoice = chooseFromList(minimalSymbolItem)

const boldSymbolItem = createMenuItemFromSymbol("Bold", "heart.fill", nil, "bold")
const boldSymbolChoice = chooseFromList(boldSymbolItem)

// Scale and mask — each value is a separate key on the action, so one item per value.
const smallSymbolItem = createMenuItemFromSymbol("Small", "microphone", nil, nil, "small")
const smallSymbolChoice = chooseFromList(smallSymbolItem)

const mediumSymbolItem = createMenuItemFromSymbol("Medium", "microphone", nil, nil, "medium")
const mediumSymbolChoice = chooseFromList(mediumSymbolItem)

const circleSymbolItem = createMenuItemFromSymbol("Circle mask", "microphone", nil, nil, "medium", true, "circle")
const circleSymbolChoice = chooseFromList(circleSymbolItem)

const roundRectSymbolItem = createMenuItemFromSymbol("Rounded rectangle mask", "microphone", nil, nil, "medium", true, "roundRect")
const roundRectSymbolChoice = chooseFromList(roundRectSymbolItem)

// Colours — a colour is a preset name or a hex. Presets are written as their hex, because Menu Box
// ignores every preset entity (a Menu Box bug, reproduced in a hand-built shortcut) while the hex
// renders. Transparent Background hides the background colour, so the background items turn it off
// to be visible.
const redSymbolItem = createMenuItemFromSymbol("Red preset", "microphone", nil, nil, "medium", true, "roundRect", "Red")
const redSymbolChoice = chooseFromList(redSymbolItem)

const greenHexSymbolItem = createMenuItemFromSymbol("Green hex", "microphone", nil, nil, "medium", true, "roundRect", "00ff00")
const greenHexSymbolChoice = chooseFromList(greenHexSymbolItem)

const presetBackgroundSymbolItem = createMenuItemFromSymbol("Red on Blue", "microphone", nil, nil, "medium", false, "roundRect", "Red", "Blue")
const presetBackgroundSymbolChoice = chooseFromList(presetBackgroundSymbolItem)

// No background colour with Transparent Background off — confirmed on device: the tile is white.
const noBackgroundSymbolItem = createMenuItemFromSymbol("Red, no background", "microphone", nil, nil, "medium", false, "roundRect", "Red")
const noBackgroundSymbolChoice = chooseFromList(noBackgroundSymbolItem)

const hexBackgroundSymbolItem = createMenuItemFromSymbol("Green on magenta", "microphone", nil, nil, "medium", false, "roundRect", "#00ff00", "ff00ff")
const hexBackgroundSymbolChoice = chooseFromList(hexBackgroundSymbolItem)

// Menu Box's own docs accept either spelling for grey, so both resolve to the Grey preset. This one
// rendered default blue as a preset entity because of the Menu Box bug, so it is now written as hex.
const grayBackgroundSymbolItem = createMenuItemFromSymbol("Gray", "microphone", nil, nil, "medium", true, "roundRect", "Gray")
const graySymbolChoice = chooseFromList(grayBackgroundSymbolItem)

// Render Icon off skips drawing the icon until the item is added to a Menu Set, so this item shows
// no icon in Choose From List. That is expected, not a failure.
const noRenderSymbolItem = createMenuItemFromSymbol("Render off", "microphone", nil, nil, nil, nil, nil, nil, nil, false)
const noRenderSymbolChoice = chooseFromList(noRenderSymbolItem)

// Mask none is the raw value Menu Box writes when None is chosen explicitly, and Fields 1 to 4 carry
// data that is read back from the chosen item (Add Data is written for them automatically).
const noMaskSymbolItem = createMenuItemFromSymbol("No mask", "microphone", nil, nil, "medium", true, "none")
const noMaskSymbolChoice = chooseFromList(noMaskSymbolItem)

const fieldsSymbolItem = createMenuItemFromSymbol("Fields", "microphone", nil, nil, nil, nil, nil, nil, nil, nil, "Field one test", "F2 test", "F3 test", "F4 test")
const fieldsSymbolChoice = chooseFromList(fieldsSymbolItem)
const fieldsSymbolDetails = text("{fieldsSymbolChoice['field1']}\n{fieldsSymbolChoice['field2']}\n{fieldsSymbolChoice['field3']}\n{fieldsSymbolChoice['field4']}")
alert(fieldsSymbolDetails)

// Create Menu Item From Emoji — title and emoji only, then each parameter on its own. Transparent
// Background is on by default for emoji, so a background colour needs it turned off to show.
const emojiItem = createMenuItemFromEmoji("Emoji", "😀")
const emojiChoice = chooseFromList(emojiItem)

const subtitleEmojiItem = createMenuItemFromEmoji("With subtitle", "😀", "emoji test subtitle")
const subtitleEmojiChoice = chooseFromList(subtitleEmojiItem)

const largeEmojiItem = createMenuItemFromEmoji("Large", "😀", nil, "large")
const largeEmojiChoice = chooseFromList(largeEmojiItem)

const circleEmojiItem = createMenuItemFromEmoji("Circle mask", "😀", nil, "large", false, "circle")
const circleEmojiChoice = chooseFromList(circleEmojiItem)

const roundRectEmojiItem = createMenuItemFromEmoji("Rounded rectangle mask", "😀", nil, "large", false, "roundRect")
const roundRectEmojiChoice = chooseFromList(roundRectEmojiItem)

const noMaskEmojiItem = createMenuItemFromEmoji("No mask", "😀", nil, nil, nil, "none")
const noMaskEmojiChoice = chooseFromList(noMaskEmojiItem)

const backgroundEmojiItem = createMenuItemFromEmoji("Magenta background", "🔥", nil, nil, false, "roundRect", "ff00ff")
const backgroundEmojiChoice = chooseFromList(backgroundEmojiItem)

const letterEmojiItem = createMenuItemFromEmoji("Letter", "A", nil, nil, false, "roundRect")
const letterEmojiChoice = chooseFromList(letterEmojiItem)

const noRenderEmojiItem = createMenuItemFromEmoji("Render off", "😀", nil, nil, nil, nil, nil, false)
const noRenderEmojiChoice = chooseFromList(noRenderEmojiItem)

const fieldsEmojiItem = createMenuItemFromEmoji("Fields", "😀", nil, nil, nil, nil, nil, nil, "Field one test", "F2 test", "F3 test", "F4 test")
const fieldsEmojiChoice = chooseFromList(fieldsEmojiItem)
const fieldsEmojiDetails = text("{fieldsEmojiChoice['title']}\n{fieldsEmojiChoice['field1']}\n{fieldsEmojiChoice['field2']}\n{fieldsEmojiChoice['field3']}\n{fieldsEmojiChoice['field4']}")
alert(fieldsEmojiDetails)

show("✅ All tests passed")
