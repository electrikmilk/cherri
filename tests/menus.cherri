// compile-only: interactive UI, not behaviorally assertable

// VCard menu

const cherri_icon = embedFile("assets/cherri_icon.png")

@items = []
repeat i for 3 {
    @items += makeVCard("Title {@i}", "Subtitle {@i}", cherri_icon)
}

const menuItems = "{@items}"
@vcf = setName(menuItems, "menu.vcf")

@contact = @vcf.contact
@chosenItem = chooseFromList(@contact, "Prompt")

alert(@chosenItem, "You chose:")

// Choose from menu

menu "Prompt" {
    item "Item 1":
        alert("Item 1", "You chose:")
    item "Item 2":
        alert("Item 2", "You chose:")
}

// Choose from menu with variables in the options

@menuValue = "x"

menu "Variable options" {
    item "{@menuValue}":
        alert("Variable", "You chose:")
    item "Static":
        alert("Static", "You chose:")
}

menu "Composite and global options" {
    item "One":
        alert("One", "You chose:")
    item "Two {@menuValue}":
        alert("Two", "You chose:")
    item "{Device['OS']}":
        alert("Device property", "You chose:")
    item "{Clipboard}":
        alert("Clipboard", "You chose:")
}

// Choose from list

@listVar = list("Item 1","Item 2","Item 3")
@chosenItem = chooseFromList(@listVar,"Choose a item")
alert(@chosenItem,"You chose:")
