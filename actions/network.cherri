/*
Network Actions
*/

enum wifiDetail {
	'Network Name',
	'BSSID',
	'Wi-Fi Standard',
	'RX Rate',
	'TX Rate',
	'RSSI',
	'Noise',
	'Channel Number',
	'Hardware MAC Address',
}

enum cellularDetail {
	'Carrier Name',
	'Radio Technology',
	'Country Code',
	'Is Roaming Abroad',
	'Number of Signal Bars',
}

// [Doc]: [Wireless] Get WiFi Detail: Get a detail of the current WiFi network.
action 'getwifi' getWifiDetail(wifiDetail detail: 'WFWiFiDetail') {
	"WFNetworkDetailsNetwork": "Wi-Fi"
}

// [Doc]: [Wireless] Get Cellular Detail: Get a detail of the current Cellular network.
action 'getwifi' getCellularDetail(cellularDetail detail: 'WFCellularDetail') {
	"WFNetworkDetailsNetwork": "Cellular"
}

enum ethernetDetail {
	'Ethernet Standard',
	'Hardware MAC Address',
	'IPv4 Address',
	'IPv6 Address',
	'Interface Name',
	'Is Connected',
	'Link Speed',
	'Router IP',
	'Subnet Mask',
}

// [Doc]: [Wireless] Get Ethernet Detail: Get a detail of the current Ethernet network.
action v27 'getwifi' getEthernetDetail(ethernetDetail detail: 'WFEthernetDetail') {
	"WFNetworkDetailsNetwork": "Ethernet"
}

enum vpnSortBy {
	'Name',
	'Random',
	'Server Address',
}

// [Doc]: [VPN] Get Current VPN: Get the VPN that is currently connected.
action v27 'vpn.get' getCurrentVPN()

// [Doc]: [VPN] Find VPNs: Find VPNs, optionally sorted and limited.
action internal v27 'filter.vpns' findVPNs(vpnSortBy ?sortBy: 'WFContentItemSortProperty', abcSortOrder ?orderBy: 'WFContentItemSortOrder', number ?limit: 'WFContentItemLimitNumber')

// [Doc]: [Server] Connect to Server: Connect to file server at `url`.
action 'connecttoservers' connectToServer(text url: 'WFInput')

enum SSHScriptAuthType {
	'Password',
	'SSH Key',
}

// [Doc]: [Server] Run SSH Script: Run an SSH script using connection details.
action runSSHScript(text script: 'WFSSHScript', variable input: 'WFInput', text host: 'WFSSHHost', text port: 'WFSSHPort', text user: 'WFSSHUser', SSHScriptAuthType authType: 'WFSSHAuthenticationType', text password: 'WFSSHPassword')

enum IPTypes {
 'IPv4',
 'IPv6',
}

// [Doc]: [IP Address] Get External IP: Get the users external IP address.
action default 'getipaddress' getExternalIP(IPTypes ?type: 'WFIPAddressTypeOption' = "IPv4"): text {
	"WFIPAddressSourceOption": "External"
}

// [Doc]: [IP Address] Get Local IP: Get the users local IP address.
action 'getipaddress' getLocalIP(IPTypes ?type: 'WFIPAddressTypeOption' = "IPv4"): text {
	"WFIPAddressSourceOption": "Local"
}

// [Doc]: [IP Address] Is Online: Determine if the user is online. Alias for get Get External IP.
action 'getipaddress' isOnline() {
	"WFIPAddressSourceOption": "External",
    "WFIPAddressTypeOption": "IPv4"
}

// [Doc]: [HotSpot] Get Hotspot Password: Get the password for your personal hotspot.
action !mac 'personalhotspot.password.get' getHotspotPassword(): text

// [Doc]: [HotSpot] Set Personal Hotspot Password: Update the password to your personal hotspot.
action !mac 'personalhotspot.password.set' setHotspotPassword(text newPassword: 'WFInput')
