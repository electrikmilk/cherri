/*
Photos Actions
*/

app Photos 'com.apple.mobileslideshow' {
    'FavoriteAssetsIntent',
    'HideAssetsIntent',
    'EnhanceIntent',
    'DeleteAlbumsIntent',
    'OpenAssetIntent',
    'AlbumEntity'
}

enum albumOrderings {
    'Oldest First',
    'Latest First',
}

// [Doc]: Favorite Photos: Add photos to Favorites.
action v27 #Photos.FavoriteAssetsIntent favoritePhotos(variable photos: 'assets')

// [Doc]: Unfavorite Photos: Remove photos from Favorites.
action v27 #Photos.FavoriteAssetsIntent unfavoritePhotos(variable photos: 'assets') {
    "action": "unfavorite"
}

// [Doc]: Hide Photos: Hide photos.
action v27 #Photos.HideAssetsIntent hidePhotos(variable photos: 'assets')

// [Doc]: Unhide Photos: Unhide photos.
action v27 #Photos.HideAssetsIntent unhidePhotos(variable photos: 'assets') {
    "action": "unhide"
}

// [Doc]: Enhance Photos: Auto enhance photos.
action v27 #Photos.EnhanceIntent enhancePhotos(variable photos: 'assets')

// [Doc]: Unenhance Photos: Remove the auto enhancement from photos.
action v27 #Photos.EnhanceIntent unenhancePhotos(variable photos: 'assets') {
    "enabled": 0
}

// [Doc]: Open Photo: Open a photo in the Photos app.
action v27 #Photos.OpenAssetIntent openPhoto(variable photo: 'target')

// [Doc]: Delete Albums: Delete albums.
action v27 #Photos.DeleteAlbumsIntent deleteAlbums(variable albums: 'entities')

// [Doc]: Find Albums: Find albums, optionally ordered by creation date and limited.
action internal v27 #Photos.AlbumEntity findAlbums(albumOrderings ?orderBy: 'WFContentItemSortOrder', number ?limit: 'WFContentItemLimitNumber')

// [Doc]: Create Album
action 'photos.createalbum' createAlbum(text name: 'AlbumName', variable ?images: 'WFInput')

// [Doc]: Rename Album
action renameAlbum(variable album: 'album', text newTitle: 'title')

// [Doc]: Search Photos
action 'com.apple.mobileslideshow.PhotosSearchAssistantIntent' searchPhotos(text criteria: 'criteria'): array

// [Doc]: Delete Photos
action deletePhotos(variable photos)

// [Doc]: Get Last Import
action 'getlatestphotoimport' getLastImport()

// [Doc]: Get Latest Bursts
action getLatestBursts(number count: 'WFGetLatestPhotoCount')

// [Doc]: Get Latest Live Photos
action 'getlatestlivephotos' getLatestLivePhotos(number count: 'WFGetLatestPhotoCount')

// [Doc]: Get Latest Screenshots
action 'getlastscreenshot' getLatestScreenshots(number count: 'WFGetLatestPhotoCount')

// [Doc]: Get Latest Photos
action 'getlastphoto' getLatestPhotos(number count: 'WFGetLatestPhotoCount', bool ?includeScreenshots: 'WFGetLatestPhotosActionIncludeScreenshots' = true)

// [Doc]: Get Latest Videos
action 'getlastvideo' getLatestVideos(number count: 'WFGetLatestPhotoCount')

// [Doc]: Remove Photo from Album
action 'removefromalbum' removeFromAlbum(variable photo: 'WFInput', text album: 'WFRemoveAlbumSelectedGroup')

// [Doc]: Save Photo to Album
action 'savetocameraroll' savePhoto(variable image: 'WFInput', text ?album: 'WFCameraRollSelectedGroup' = "Recents")

// [Doc]: Select Photos: Prompt the user to select from their photo library.
action 'selectphoto' selectPhotos(bool ?selectMultiple: 'WFSelectMultiplePhotos' = false)
